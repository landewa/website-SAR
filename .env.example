# GEMINI_API_KEY: Required for Gemini AI API calls for JARVIS.
# Local: Configure in your local .env file
# Vercel: Set in Vercel Project Settings > Environment Variables
GEMINI_API_KEY="YOUR_GEMINI_API_KEY_HERE"

# Optional: Override Gemini Model (defaults to gemini-3.8-flash with fallback to gemini-2.5-flash)
# GEMINI_MODEL="gemini-3.8-flash"

# APP_URL: The public URL of the application
APP_URL="https://saadareserve.com"
